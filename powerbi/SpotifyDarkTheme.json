{
  "name": "Spotify Dark (custom)",
  "dataColors": [
    "#1DB954",
    "#1ED760",
    "#B3B3B3",
    "#2D46B9",
    "#F573A0",
    "#FFC864",
    "#509BF5",
    "#AF2896",
    "#E8115B",
    "#148A08"
  ],
  "background": "#121212",
  "foreground": "#FFFFFF",
  "tableAccent": "#1DB954",
  "good": "#1DB954",
  "neutral": "#B3B3B3",
  "bad": "#E8115B",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF",
      "fontSize": 12
    },
    "label": {
      "fontFace": "Segoe UI",
      "color": "#B3B3B3",
      "fontSize": 10
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "color": "#1DB954",
      "fontSize": 28
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF",
      "fontSize": 12
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#121212"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#000000"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#181818"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "inputBoxColor": {
              "solid": {
                "color": "#282828"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#333333"
              }
            },
            "transparency": 0
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#1E3326"
