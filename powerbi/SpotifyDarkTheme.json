            "foregroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "inputBoxColor": {
              "solid": {
                "color": "#282828"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#333333"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#181818"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#181818"
              }
            },
            "foreground": {
              "solid": {
                "color": "#B3B3B3"
              }
            }
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#B3B3B3"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#B3B3B3"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#2A2A2A"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#B3B3B3"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#B3B3B3"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#2A2A2A"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#B3B3B3"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1DB954"
              }
            },
            "labelDisplayUnits": 0
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#B3B3B3"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "background": {
              "solid": {
                "color": "#181818"
              }
            }
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#B3B3B3"
              }
            }
          }
        ],
        "date": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "background": {
              "solid": {
                "color": "#282828"
              }
            }
          }
        ],
        "numericInputStyle": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "background": {
              "solid": {
                "color": "#282828"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ]
      }
    }
  }
}