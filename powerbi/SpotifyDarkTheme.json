            },
            "foregroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "inputBoxColor": {
              "solid": {
                "color": "#282828"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#1DB954"
              }
            },
            "transparency": 0
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#222222"
              }
